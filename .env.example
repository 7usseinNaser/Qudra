ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://qudra:qudra@db:5432/qudra
POSTGRES_USER=qudra
POSTGRES_PASSWORD=qudra
POSTGRES_DB=qudra

# JWT — generate a real secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
